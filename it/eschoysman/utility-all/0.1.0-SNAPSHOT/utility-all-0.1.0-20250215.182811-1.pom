<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>utility</artifactId>
        <groupId>it.eschoysman</groupId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>utility-all</artifactId>
    <packaging>jar</packaging>

    <properties>
        <maven-antrun-plugin.version>3.1.0</maven-antrun-plugin.version>
    </properties>

    <build>
        <plugins>
            <!-- Plugin to combine JARs and classes -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven-antrun-plugin.version}</version>
                <executions>
                    <execution>
                        <id>combine-jars</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}"/>
                                <jar destfile="${project.build.directory}/${project.artifactId}-${project.version}.jar">
                                    <fileset dir="../utility-core/target/classes"><include name="**/*.class"/></fileset>
                                    <fileset dir="../utility-math/target/classes"><include name="**/*.class"/></fileset>
                                    <fileset dir="../fluent/target/classes"><include name="**/*.class"/></fileset>
                                    <fileset dir="../utility-datastructures/target/classes"><include name="**/*.class"/></fileset>
                                    <fileset dir="../utility-file/target/classes"><include name="**/*.class"/></fileset>
                                    <fileset dir="../utility-printer/target/classes"><include name="**/*.class"/></fileset>
                                    <fileset dir="../utility-wip/target/classes"><include name="**/*.class"/></fileset>
                                </jar>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.github</groupId>
                <artifactId>site-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>